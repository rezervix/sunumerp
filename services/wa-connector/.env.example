# wa-connector .env Örnek Dosyası
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# wa-connector portu (sadece localhost'ta dinler)
PORT=3001

# ai-orchestrator adresi (dahili HTTP)
ORCHESTRATOR_URL=http://localhost:3002

# Dahili servisler arası paylaşılan gizli anahtar
# openssl rand -hex 32 ile üretin
INTERNAL_SECRET=your-strong-random-secret-here

# Baileys session dizini
SESSION_DIR=./sessions/erp-main

# Log seviyesi: trace | debug | info | warn | error
LOG_LEVEL=info

# Admin bildirim webhook (opsiyonel — oturum kapandığında POST atılır)
# ADMIN_WEBHOOK_URL=https://hooks.slack.com/...
