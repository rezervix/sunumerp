# ai-orchestrator .env Örnek Dosyası

# Servis portu (sadece localhost dinler)
PORT=3002

# wa-connector adresi
WA_CONNECTOR_URL=http://localhost:3001

# Dahili servisler arası paylaşılan gizli anahtar (wa-connector ile AYNI olmalı)
# openssl rand -hex 32 ile üretin
INTERNAL_SECRET=your-strong-random-secret-here

# ─── LLM Sağlayıcı ───────────────────────────────────────────────────────────
# Seçenekler: gemini | anthropic | openai | ollama
LLM_PROVIDER=gemini

# Gemini (Mevcut ERP'deki key kullanılır)
GEMINI_API_KEY=AIzaSyAgcDNHqgkK0Sn2cWaozYalttcP6j7q5tw
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Anthropic Claude (LLM_PROVIDER=anthropic için)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI GPT (LLM_PROVIDER=openai için)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (LLM_PROVIDER=ollama için — yerel kurulum)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Veritabanı ──────────────────────────────────────────────────────────────
# ai_readonly rolüyle bağlan (ana ERP bağlantısından TAMAMEN BAĞIMSIZ)
AI_DB_URL=postgresql://ai_readonly:AiAgent_Secure_2024!@localhost:5432/crm_cicekana

# ─── ERP API ─────────────────────────────────────────────────────────────────
# CustomerChat ve webhook için ERP Next.js API adresi
ERP_API_URL=http://localhost:3005
# ERP'de bir "ai-service" kullanıcısı oluşturup buraya JWT token'ı girin
ERP_SERVICE_TOKEN=your-erp-service-jwt-token

# ─── İşletme Bilgisi ─────────────────────────────────────────────────────────
BUSINESS_NAME=Çiçekana Tech Media

# ─── Shadow Mode ─────────────────────────────────────────────────────────────
# true  → AI yanıt üretir ama GÖNDERMEZ (güvenli test modu)
# false → AI yanıtları gerçekten gönderilir
SHADOW_MODE=true

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Aynı numaradan 60s içinde maksimum mesaj sayısı
MAX_MESSAGES_PER_MINUTE=10

# Log seviyesi
LOG_LEVEL=info
