model NightScanLog {
  id          String   @id @default(uuid())
  branchId    String?
  status      String   @default("running") // running, completed, failed
  startedAt   DateTime @default(now())
  completedAt DateTime?
  totalFound  Int      @default(0)
  errorLog    String?
