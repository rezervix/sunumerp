// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?
  password  String
  fullName  String
  phone     String?
  avatarUrl  String?
  department String?
  position   String?
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             UserBranchRole[]
  sentMessages         Message[]            @relation("SentMessages")
  announcements        Announcement[]
  auditLogs            AuditLog[]
  todos                Todo[]
  notes                Note[]
  calculationHistories CalculationHistory[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  aiRevisionAnalyses   AiRevisionAnalysis[]
  createdLeads         Lead[]               @relation("CreatedLeads")
  taskStatusHistories  TaskStatusHistory[]
  libraryFoldersCreated  LibraryFolder[]        @relation("LibraryFolderCreator")
  libraryFilesUploaded   LibraryFile[]          @relation("LibraryFileUploader")
  libraryPermissionsGranted LibraryFilePermission[] @relation("LibraryPermissionGranter")
  libraryConversionJobs  LibraryConversionJob[] @relation("LibraryJobRequester")
  libraryActivityLogs    LibraryActivityLog[]   @relation("LibraryActivityUser")
  contentStoreUploaded   ContentStore[]         @relation("ContentStoreUploadedBy")
  contentStoreApproved   ContentStore[]         @relation("ContentStoreApprovedBy")
  contentVersionsUploaded ContentVersion[]      @relation("ContentVersionUploadedBy")
  contentAnalyticsEvents ContentAnalyticsEvent[] @relation("ContentAnalyticsEventUser")
  createdRevisions       RevisionRequest[]      @relation("CreatedRevisions")
  completedRevisions     RevisionRequest[]      @relation("CompletedRevisions")

  // Görev Yönetimi İlişkileri
  assignedTasks InternalTask[] @relation("TasksAssigned")
  receivedTasks InternalTask[] @relation("TasksReceived")
  activeTask         ActiveTask?
  taskStatusLogs     InternalTaskStatusLog[]

  // ── WhatsApp Chat System Relations ──────────────────
  chatParticipations   ChatParticipant[]     @relation("ChatParticipations")
  messageReactions     MessageReaction[]     @relation("MessageReactions")
  messageReadReceipts  MessageReadReceipt[]  @relation("MessageReadReceipts")
  messageMentions      MessageMention[]      @relation("Mentions")
  pinnedMessages       PinnedMessage[]       @relation("PinnedByUser")
  starredMessages      MessageStar[]         @relation("StarredMessages")
  chatMuteSettings     ChatMuteSettings[]    @relation("ChatMuteSettings")
  presence             UserPresence?         @relation("UserPresence")
  blockedUsers         UserBlock[]           @relation("BlockedByUser")
  blockedByUsers       UserBlock[]           @relation("BlockedUsers")
  broadcastLists       BroadcastList[]       @relation("BroadcastLists")
  broadcastMemberships BroadcastListMember[] @relation("BroadcastMemberships")
  chatWallpapers       ChatWallpaper[]       @relation("ChatWallpapers")
  messageForwards      MessageForward[]      @relation("ForwardedByUser")

  lastLoginAt          DateTime?
  mustChangePassword   Boolean               @default(false)
  createdBy            String?
  sessions             UserSession[]
  passwordResetLogs    PasswordResetLog[]
  eodReports           EodReport[]
  reportedTickets      SupportTicket[]      @relation("ReportedTickets")
  assignedTickets      SupportTicket[]      @relation("AssignedTickets")
  trashItems           TrashItem[]
}

model Branch {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  address          String?
  phone            String?
  email            String?
  managerId        String?
  managerFullName  String?
  logoUrl          String?
  themeColor       String   @default("#3B82F6")
  timezone         String   @default("Europe/Istanbul")
  operationalHours String? // Stored as JSON string
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              UserBranchRole[]
  customers          Customer[]
  projects           Project[]
  leads              Lead[]
  finances           Finance[]
  orders             Order[]
  files              File[]
  reminders          Reminder[]
  sentDeliveries     FileDelivery[]   @relation("SentDeliveries")
  receivedDeliveries FileDelivery[]   @relation("ReceivedDeliveries")
  branchPrices       BranchPrice[]
  stockRequests      StockRequest[]
  cargoTrackings     CargoTracking[]
  candidates         Candidate[]
  appointments       Appointment[]
  nightScanResults   NightScanResult[]
  contentCalendars    ContentCalendar[]
  libraryFolders     LibraryFolder[]
  libraryFiles       LibraryFile[]
  // Deprecated: messages field removed - now via ChatConversation.branchId

  // İçerik Takvimi Yönetim Sistemi
  contentItems       ContentItem[]
  productionShoots   ProductionShoot[]
  internalTasks      InternalTask[]
  trashItems         TrashItem[]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  permissions String // Stored as JSON string

  userBranches UserBranchRole[]
}

model UserBranchRole {
  id         String   @id @default(uuid())
  userId     String
  branchId   String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId])
}

model Customer {
  id           String    @id @default(uuid())
  branchId     String
  name         String?   // Changed to be optional
  company      String?
  email        String?
  phone        String?
  address      String?
  status       String    @default("active") // active, pending, inactive
  scoreTemp    String?   @default("Ilik") // Cold, Warm, Hot, VP
  purchaseProb Int?      // Purchase probability percentage
  segment      String?   // Wholesale, Retail, Corporate etc.
  recallDate   DateTime? // Recall date
  anniversary  DateTime? // Birthday etc.
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders       Order[]
  notes        CustomerNote[]
  chats        CustomerChat[]
  documents    CustomerDocument[]
  tasks        CustomerTask[]
  contacts     CustomerContact[]
  aiMemories   AiConversationMemory[]
  aiAgentLogs  AiAgentLog[]
}

model Project {
  id            String    @id @default(uuid())
  branchId      String
  name          String
  description   String?
  status        String    @default("active") // active, completed, on_hold
  progress      Int       @default(0)
  startDate     DateTime?
  endDate       DateTime?
  customerNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Lead {
  id               String   @id @default(uuid())
  branchId         String
  name             String
  company          String?
  email            String?
  phone            String?
  status           String   @default("new") // new, contacted, qualified, lost, hot, warm, cold
  source           String?
  notes            String?
  digitalAssets    String? // JSON: stored credentials, digital info
  serviceSelection String? // Selected services (JSON array)
  amount           Float? // Potential revenue amount
  painPoint        String? // Pain point or customer needs
  instagramUrl     String? // Instagram page link
  websiteUrl       String? // Website link
  googleMapsUrl    String? // Google Maps business link

  // Firma Bilgileri
  employeeCount     String?   // "1-9", "10-49", "50-249", "250+"
  industry          String?   // "İnşaat", "Tekstil", vb.
  companyAge        String?   // "1 yıldan az", "1-3 yıl", vb.
  legalStructure    String?   // "Şahıs Şirketi", "Limited Şirket", vb.
  currentERP        String?   // Serbest metin
  competitorInUse   String?   // Serbest metin

  // Satış Süreci Alanları
  scoreTemp          String?   // "Soğuk", "Ilık", "Sıcak"
  budgetRange        String?   // Fiyat aralığı dropdown
  timeline           String?   // "Hemen", "Kısa vade", vb.
  decisionStructure  String?   // "Patron/Kurucu", vb.
  lastContactedAt    DateTime? // Son iletişim tarihi
  nextFollowUpDate   DateTime? // Takip tarihi
  referralSource     String?   // "Instagram", "Web Sitesi", vb.
  createdById        String?   // Kaydı oluşturan kullanıcı

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, status])
}

model Order {
  id            String   @id @default(uuid())
  branchId      String
  customerId    String?
  orderNumber   String?
  title         String
  description   String?
  orderType     String
  quantity      Int?
  priority      String   @default("normal")
  status        String   @default("pending") // pending, approved, in-progress, delivered, rejected
  paymentStatus String   @default("unpaid") // paid, unpaid, partial
  totalAmount   Float?
  customerName  String?
  companyName   String?
  customerPhone String?
  files         String?  // JSON array of file URLs
  orderDate     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId, status])
}

model File {
  id                 String   @id @default(uuid())
  branchId           String
  name               String
  url                String
  type               String
  size               Int
  uploadedBy         String?
  contentCalendarId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  contentCalendar ContentCalendar? @relation(fields: [contentCalendarId], references: [id], onDelete: SetNull)
}

model Reminder {
  id          String    @id @default(uuid())
  branchId    String
  title       String
  description String?
  category    String?   @default("Genel")
  startDate   DateTime?
  dueDate     DateTime
  priority    String    @default("normal")
  status      String    @default("pending") // pending, completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model FileDelivery {
  id             String    @id @default(uuid())
  fromBranchId   String
  toBranchId     String?
  fromUserId     String?
  toUserId       String?
  trackingNumber String
  title          String
  description    String?
  fileUrls       String // Stored as JSON string
  status         String    @default("sent") // sent, received, acknowledged, completed
  priority       String    @default("normal")
  sentAt         DateTime  @default(now())
  receivedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fromBranch Branch  @relation("SentDeliveries", fields: [fromBranchId], references: [id])
  toBranch   Branch? @relation("ReceivedDeliveries", fields: [toBranchId], references: [id])
}

// B2B Store
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  unit        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices        BranchPrice[]
  stockRequests StockRequest[]
  inventoryItem InventoryItem?
}

model BranchPrice {
  id        String @id @default(uuid())
  productId String
  branchId  String
  price     Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
}

model StockRequest {
  id         String   @id @default(uuid())
  branchId   String
  productId     String?
  customProduct String?
  quantity      Int
  status        String   @default("pending") // pending, approved, rejected, delivered
  approvedBy    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

// Cargo Tracking
model CargoTracking {
  id             String   @id @default(uuid())
  branchId       String
  carrierName    String
  trackingNumber String
  status         String   @default("in_transit") // in_transit, delivered, returned, lost
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

// =====================================================
// WHATSAPP-LIKE CHAT SYSTEM — TAM ENTEGRASYON ŞEMASI
// =====================================================

// Konuşma tipi: doğrudan mesaj (dm) veya grup
// "branch_channel" şube geneli kanalı temsil eder
model ChatConversation {
  id              String   @id @default(uuid())
  type            String   @default("dm")         // dm | group | branch_channel | broadcast
  name            String?                          // Grup/kanal adı (DM'de null)
  description     String?                          // Grup açıklaması
  avatarUrl       String?                          // Grup profil fotoğrafı
  branchId        String?                          // Şubeye bağlı kanallar için
  createdById     String                           // Grubu/konuşmayı oluşturan
  isArchived      Boolean  @default(false)
  isBroadcast     Boolean  @default(false)         // Broadcast listesi mi
  lastMessageId   String?  @unique                 // Hızlı önizleme için son mesaj
  lastActivityAt  DateTime @default(now())         // Sıralama için son aktivite
  maxParticipants Int      @default(1024)          // Grup üye limiti (default: WhatsApp limiti)
  onlyAdminCanMessage Boolean @default(false)      // Sadece adminler mesaj gönderebilir mi
  onlyAdminCanEditInfo Boolean @default(false)     // Sadece adminler grup bilgilerini düzenleyebilir mi
  disappearingMessages Boolean @default(false)     // Kaybolan mesajlar aktif mi
  disappearingDuration Int?                        // Kaybolan mesaj süresi (saniye)
  inviteLink      String?  @unique                 // Gruba davet linki
  inviteLinkActive Boolean @default(true)
  customEmoji     String?                          // Konuşmaya özel emoji (JSON array)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants    ChatParticipant[]
  messages        Message[]
  pinnedMessages  PinnedMessage[]
  wallpapers      ChatWallpaper[]
  muteSettings    ChatMuteSettings[]

  @@index([branchId])
  @@index([lastActivityAt])
  @@index([type])
}

// Konuşma katılımcıları — hem DM hem grup için
model ChatParticipant {
  id               String    @id @default(uuid())
  conversationId   String
  userId           String
  role             String    @default("member")   // member | admin | super_admin
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?                      // Gruptan ayrılma tarihi
  removedById      String?                        // Kim çıkardı
  isRemoved        Boolean   @default(false)      // Gruptan çıkarıldı mı
  lastReadAt       DateTime?                      // Bu kullanıcının bu konuşmada son okuduğu zaman
  lastReadMessageId String?                       // Son okunan mesaj ID (unread count için)
  notificationSound String?                       // Özel bildirim sesi
  nickname          String?                       // Grup içi takma ad

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

// Ana mesaj modeli — tüm WhatsApp özellikleri
model Message {
  id               String    @id @default(uuid())
  conversationId   String                           // Hangi konuşmaya ait
  fromUserId       String                           // Gönderen
  content          String    @default("")           // Metin içeriği
  contentType      String    @default("text")       // text | image | video | audio | voice | document | sticker | location | contact | system | poll | deleted
  
  // Dosya/Medya alanları
  fileUrl          String?                          // Yüklenen dosya URL'i
  fileType         String?                          // MIME tipi (image/jpeg, video/mp4 vb.)
  fileName         String?                          // Orijinal dosya adı
  fileSize         BigInt?                          // Dosya boyutu (byte)
  fileDuration     Int?                             // Ses/video süresi (saniye)
  thumbnailUrl     String?                          // Video/belge küçük resmi
  waveformData     String?                          // Ses dalgaformu verisi (JSON float array)
  
  // Konum paylaşımı
  locationLat      Float?
  locationLng      Float?
  locationAddress  String?
  locationName     String?                          // Yer adı (Google Maps entegrasyonu)
  
  // Yanıt (Reply) alanları
  replyToMessageId String?                          // Yanıt verilen mesaj ID'si
  replyPreviewText String?                          // Hızlı önizleme metni (denormalized)
  replyPreviewType String?                          // Yanıt verilen mesajın tipi
  replyFromUserId  String?                          // Yanıt verilen mesajı gönderenin adı
  
  // İletme (Forward) alanları
  isForwarded      Boolean   @default(false)
  forwardedFromConversationId String?               // Kaynak konuşma
  forwardCount     Int       @default(0)            // Kaç kez iletildi (WhatsApp: çok iletildi etiketi)
  
  // Mesaj durumu
  isEdited         Boolean   @default(false)
  editedAt         DateTime?
  isDeleted        Boolean   @default(false)        // Herkes için sil
  deletedAt        DateTime?
  deletedForAll    Boolean   @default(false)        // "Bu mesaj silindi" olarak gösterilecek mi
  isSelfDestruct   Boolean   @default(false)        // Kaybolan mesaj mı
  selfDestructAt   DateTime?                        // Kaybolan mesaj ne zaman silinecek
  
  // Yıldız/Sabitleme
  isStarred        Boolean   @default(false)        // Gönderenin yıldızladı mı (kişisel)
  isPinned         Boolean   @default(false)        // Sohbet içinde sabitlendi mi
  
  // Sistem mesajları
  isSystemMessage  Boolean   @default(false)        // "X gruba eklendi", "Y admin oldu" gibi
  systemAction     String?                          // group_created | member_added | member_removed | admin_granted | admin_revoked | link_changed | name_changed | avatar_changed | disappearing_on | disappearing_off
  
  // Poll (Anket) — JSON olarak saklanır
  pollData         String?                          // JSON: { question, options: [{id, text, votes: [userId]}], isAnonymous, allowMultiple, expiresAt }
  
  // Yayın zamanlaması (görüntüleme saati)
  scheduledAt      DateTime?
  
  // Eski sistem ile geriye uyumluluk (migration geçiş dönemi)
  toUserId         String?   @db.Uuid              // DEPRECATED - conversationId kullanılacak
  branchId         String?                          // DEPRECATED - conversationId üzerinden
  isRead           Boolean   @default(false)        // DEPRECATED - MessageReadReceipt kullanılacak

  // WhatsApp import alanları
  importedFrom     String?                          // Kaynak platform: "whatsapp"
  importedAt       DateTime?                        // Import anı (not: createdAt = orijinal WhatsApp zaman damgası)
  externalId       String?                          // Duplicate koruması: SHA-256(content+timestamp+sender)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // İlişkiler
  fromUser         User              @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  conversation     ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyToMessage   Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]         @relation("MessageReplies")
  reactions        MessageReaction[]
  readReceipts     MessageReadReceipt[]
  mentions         MessageMention[]
  pinnedIn         PinnedMessage[]
  voiceMessage     VoiceMessage?
  forwardHistory   MessageForward[]  @relation("ForwardedMessage")
  starredBy        MessageStar[]

  @@index([conversationId, createdAt])
  @@index([fromUserId])
  @@index([isDeleted])
  @@index([replyToMessageId])
  @@index([selfDestructAt])
  @@unique([conversationId, externalId], name: "Message_conversationId_externalId_unique")
}

// Emoji reaksiyonları — bir mesaja birden fazla kullanıcı farklı emoji atabilir
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String                              // Unicode emoji: "👍", "❤️", "😂" vb.
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])           // Aynı kullanıcı aynı emojiyi bir kez atabilir
  @@index([messageId])
  @@index([userId])
}

// Çoklu okundu bilgisi — her katılımcı için ayrı okundu kaydı (grup mesajları için çift/üç tik)
model MessageReadReceipt {
  id         String   @id @default(uuid())
  messageId  String
  userId     String
  readAt     DateTime @default(now())
  deliveredAt DateTime?                         // Teslim edildi (cihaza ulaştı) anı

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReadReceipts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// @mention kayıtları — bir mesajda birden fazla mention olabilir
model MessageMention {
  id          String @id @default(uuid())
  messageId   String
  mentionedUserId String

  message       Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation("Mentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, mentionedUserId])
  @@index([mentionedUserId])
}

// Sohbet içi sabitlenmiş mesajlar — bir sohbette birden fazla mesaj sabitlenebilir
model PinnedMessage {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String
  pinnedById     String
  pinnedAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User             @relation("PinnedByUser", fields: [pinnedById], references: [id])

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

// Sesli mesaj detayları
model VoiceMessage {
  id         String  @id @default(uuid())
  messageId  String  @unique
  duration   Int                              // Saniye cinsinden süre
  waveform   String?                          // Float array JSON (ses dalgaformu görselleştirmesi)
  isListened Boolean @default(false)          // Alıcı dinledi mi (bir kez gösterme)
  fileSize   BigInt?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Mesaj iletme geçmişi — zinciri takip etmek için
model MessageForward {
  id                   String   @id @default(uuid())
  originalMessageId    String                       // Orijinal mesaj
  forwardedMessageId   String                       // İletilen yeni mesaj
  forwardedByUserId    String
  forwardedAt          DateTime @default(now())

  originalMessage  Message @relation("ForwardedMessage", fields: [originalMessageId], references: [id], onDelete: Cascade)
  forwardedBy      User    @relation("ForwardedByUser", fields: [forwardedByUserId], references: [id])

  @@index([originalMessageId])
}

// Yıldızlanan mesajlar — kullanıcı kişisel yıldız listesi
model MessageStar {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  starredAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("StarredMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// Sessizleştirme ayarları — kullanıcı bazında, konuşma bazında
model ChatMuteSettings {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  mutedUntil     DateTime?                     // null = kalıcı sessiz; tarih = o tarihe kadar sessiz
  showPreview    Boolean   @default(true)      // Bildirimde içerik gösterilsin mi
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatMuteSettings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Kullanıcı anlık durum takibi — online/offline/yazıyor/ses kaydediyor
model UserPresence {
  id              String   @id @default(uuid())
  userId          String   @unique
  isOnline        Boolean  @default(false)
  lastSeenAt      DateTime @default(now())
  lastSeenHidden  Boolean  @default(false)       // "Son görülme" gizle
  typingInConversationId String?                 // Şu an hangi konuşmada yazıyor (null = yazmıyor)
  recordingInConversationId String?              // Şu an hangi konuşmada ses kaydediyor
  updatedAt       DateTime @updatedAt

  user User @relation("UserPresence", fields: [userId], references: [id], onDelete: Cascade)

  @@index([isOnline])
}

// Kullanıcı engelleme listesi
model UserBlock {
  id          String   @id @default(uuid())
  blockerId   String                              // Kim engelledi
  blockedId   String                              // Kim engellendi
  createdAt   DateTime @default(now())

  blocker User @relation("BlockedByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Broadcast (Yayın) listeleri — grubun bilmediği toplu mesaj gönderimi
// Her broadcast listesi için ayrı bir ChatConversation (type=broadcast) otomatik oluşturulur
model BroadcastList {
  id          String   @id @default(uuid())
  name        String
  createdById String
  branchId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User                  @relation("BroadcastLists", fields: [createdById], references: [id], onDelete: Cascade)
  members     BroadcastListMember[]

  @@index([createdById])
}

// Broadcast listesi üyeleri
model BroadcastListMember {
  id              String   @id @default(uuid())
  broadcastListId String
  userId          String
  addedAt         DateTime @default(now())

  broadcastList BroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  user          User          @relation("BroadcastMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastListId, userId])
  @@index([broadcastListId])
}

// Sohbet duvar kağıdı ayarları — kullanıcı bazında, konuşma bazında özel arka plan
model ChatWallpaper {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  wallpaperType  String   @default("default")  // default | color | image
  colorValue     String?                        // HEX renk kodu
  imageUrl       String?                        // Özel arka plan resmi
  opacity        Float    @default(1.0)          // Şeffaflık (0-1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatWallpapers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

// Eski Message modeli ile geriye uyumluluk için branch ilişkisi
// (Migration geçiş döneminde kullanılacak, daha sonra kaldırılacak)

// Announcements
model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  targetType  String   @default("all") // branch, staff, all
  targetIds   String? // JSON array of branch/user Ids
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
}

// Audit Log
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
}

// To-Do Module
model Todo {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    String    @default("medium") // low, medium, high
  status      String    @default("pending") // pending, completed
  dueDate     DateTime?
  attachments String?  @default("[]") // JSON array of uploaded file URLs
  startDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Notes Module
model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Smart Pricing Engine (Hesaplama Araci)
model CalculationHistory {
  id                String   @id @default(uuid())
  userId            String
  productCost       Float
  totalCost         Float
  appliedProfitRate Float
  profitAmount      Float
  totalPrice        Float? // Backward compatibility
  finalPrice        Float
  roundingStrategy  String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String   @default("info") // info, success, warning, error, task, reminder
