// ÜRETİM MODÜLLERİ — ANA VERİLER VE STOK KARTI 1-1 ÜRETİM PROFİLİ (ADDITIVE)
// ═══════════════════════════════════════════════════════════════════════════════

model UretimWorkCalendar {
  id              String   @id @default(uuid())
  branchId        String?
  code            String   @unique
  name            String
  workingDaysJson String   @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\",\"SAT\"]")
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shifts          UretimShift[]
  holidays        UretimCalendarHoliday[]
  exceptions      UretimCalendarException[]
  workCenters     UretimWorkCenter[]

  @@index([branchId])
  @@index([isActive])
}

model UretimShift {
  id                 String             @id @default(uuid())
  calendarId         String
  code               String             @unique
  name               String
  startTime          String             @default("08:00")
  endTime            String             @default("17:00")
  breakMinutes       Int                @default(60)
  netWorkingMinutes  Int                @default(480)
  capacityMultiplier Float              @default(1.0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  calendar           UretimWorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  workCenters        UretimWorkCenter[]

  @@index([calendarId])
  @@index([isActive])
}

model UretimCalendarHoliday {
  id                String             @id @default(uuid())
  calendarId        String
  holidayDate       String
  name              String
  isHalfDay         Boolean            @default(false)
  isRecurringYearly Boolean            @default(false)
  notes             String?
  createdAt         DateTime           @default(now())

  calendar          UretimWorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId, holidayDate])
}

model UretimWorkCenter {
  id                   String                    @id @default(uuid())
  branchId             String?
  warehouseId          String?
  code                 String                    @unique
  name                 String
  type                 String                    @default("MACHINE") // MACHINE, MANUAL, OUTSOURCE
  hourlyCost           Float                     @default(0)
  capacityPerHour      Float                     @default(1)
  efficiencyPercent    Float                     @default(100)
  calendarId           String?
  defaultShiftId       String?
  alternativeGroupCode String?
  isActive             Boolean                   @default(true)
  notes                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  calendar             UretimWorkCalendar?       @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  defaultShift         UretimShift?              @relation(fields: [defaultShiftId], references: [id], onDelete: SetNull)
  machines             UretimMachineAsset[]
  calendarExceptions   UretimCalendarException[]
  itemProfiles         UretimItemProfile[]
  operations           UretimOperation[]
  alternativeOperations UretimOperationAlternativeWorkCenter[]
  workOrderOperations  UretimWorkOrderOperation[]
  capacityPlanItems    UretimCapacityPlanItem[]
  scheduledTasks       UretimScheduledTask[]
  capacityAlerts       UretimCapacityAlert[]
  timeVariances        UretimOperationTimeVariance[]
  maintenanceWorkOrders UretimMaintenanceWorkOrder[]

  @@index([branchId])
  @@index([type])
  @@index([alternativeGroupCode])
  @@index([isActive])
}

model UretimCalendarException {
  id              String             @id @default(uuid())
  calendarId      String
  workCenterId    String
  exceptionDate   String
  exceptionType   String             @default("CLOSED") // OVERTIME, CLOSED, REDUCED_CAPACITY, SHIFT_OVERRIDE
  availableHours  Float              @default(0)
  capacityPercent Float              @default(0)
  reason          String?
  createdAt       DateTime           @default(now())

  calendar        UretimWorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  workCenter      UretimWorkCenter   @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([calendarId, exceptionDate])
  @@index([workCenterId, exceptionDate])
}

model UretimMachineAsset {
  id               String            @id @default(uuid())
  branchId         String?
  code             String            @unique
  name             String
  serialNumber     String            @unique
  brand            String?
  model            String?
  warrantyEndDate  String?
  warrantyProvider String?
  location         String?
  workCenterId     String?
  status           String            @default("ACTIVE") // ACTIVE, MAINTENANCE, FAULT, STANDBY, DECOMMISSIONED
  operatingHours   Float             @default(0)
  productionCount  Float             @default(0)
  criticality      String            @default("B") // A (Kritik), B (Önemli), C (Standart)
  parentAssetId    String?
  category         String?
  acquisitionCost  Float             @default(0)
  documentUrl      String?
  isActive         Boolean           @default(true)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workCenter             UretimWorkCenter?                    @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  parentAsset            UretimMachineAsset?                  @relation("MachineHierarchy", fields: [parentAssetId], references: [id], onDelete: SetNull)
  subAssets              UretimMachineAsset[]                 @relation("MachineHierarchy")
  spareParts             UretimMachineSparePart[]
  maintenancePlans       UretimMaintenancePlan[]
  maintenanceWorkOrders  UretimMaintenanceWorkOrder[]
  conditionReadings      UretimMaintenanceConditionReading[]

  @@index([workCenterId])
  @@index([status])
  @@index([branchId])
  @@index([parentAssetId])
}

model UretimParameters {
  id                              String   @id @default(uuid())
  branchId                        String?  @unique
  planningHorizonDays             Int      @default(30)
  planningBucket                  String   @default("DAILY") // DAILY, WEEKLY, MONTHLY
  defaultLotSizingRule            String   @default("L4L")   // L4L, FOQ, EOQ, POQ
  defaultMinLotSize               Float    @default(1)
  defaultLotMultiple              Float    @default(1)
  defaultSafetyStockRule          String   @default("FIXED") // FIXED, DAYS_OF_SUPPLY, PERCENTAGE
  defaultSafetyStockValue         Float    @default(10)
  defaultSafetyStockDays          Int      @default(3)
  requireWorkOrderApproval        Boolean  @default(true)
  requireQualityCheckOnComplete   Boolean  @default(false)
  autoBackflushOnComplete         Boolean  @default(true)
  autoReserveOnRelease            Boolean  @default(true)
  allowOverProductionPercent      Float    @default(5)
  allowNegativeStockInProduction  Boolean  @default(false)
  defaultManufacturingWarehouseId String?
  statusFlowJson                  String   @default("[\"DRAFT\",\"PLANNED\",\"RELEASED\",\"IN_PROGRESS\",\"QA_PENDING\",\"COMPLETED\"]")
  updatedBy                       String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model UretimItemProfile {
  id                      String            @id @default(uuid())
  itemId                  String            @unique
  productionItemType      String            @default("MAMUL") // HAMMADDE, YARI_MAMUL, MAMUL, SARF_MALZEME, TICARI_MAL
  productionMethod        String            @default("MAKE_TO_STOCK") // MAKE_TO_STOCK, MAKE_TO_ORDER, ASSEMBLE_TO_ORDER, SUBCONTRACT, PURCHASE_ONLY
  leadTimeDays            Int               @default(3)
  productionLeadTimeHours Float             @default(4)
  minStockLevel           Float             @default(10)
  safetyStockQty          Float             @default(5)
  lotSizingRule           String            @default("L4L") // L4L, FOQ, EOQ, POQ
  standardLotSize         Float             @default(1)
  minOrderQty             Float             @default(1)
  orderMultiple           Float             @default(1)
  defaultBomId            String?
  defaultWorkCenterId     String?
  scrapTolerancePercent   Float             @default(2)
  backflushEnabled        Boolean           @default(true)
  qualityCheckRequired    Boolean           @default(false)
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  item                    InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  defaultBom              BomHeader?        @relation("DefaultBomForItemProfile", fields: [defaultBomId], references: [id], onDelete: SetNull)
  defaultWorkCenter       UretimWorkCenter? @relation(fields: [defaultWorkCenterId], references: [id], onDelete: SetNull)

  @@index([productionItemType])
  @@index([productionMethod])
  @@index([defaultBomId])
  @@index([defaultWorkCenterId])
}

// ─────────────────────────────────────────────────────────────
// FAZ 3: ÜRÜN REÇETELERİ (BOM) & ROTALAR (ROUTING) MODELLERİ
// ─────────────────────────────────────────────────────────────

model UretimBomHeader {
  id                    String                @id @default(uuid())
  branchId              String?
  finishedItemId        String
  code                  String                @unique
  name                  String
  revision              String                @default("01")
  status                String                @default("DRAFT") // DRAFT, APPROVED, OBSOLETE
  effectiveStartDate    String?               // YYYY-MM-DD
  effectiveEndDate      String?               // YYYY-MM-DD
  baseQuantity          Float                 @default(1)
  baseUnit              String                @default("Adet")
  isPhantom             Boolean               @default(false)
  variantCode           String?
  yieldPercent          Float                 @default(100.0)
  totalMaterialCost     Float                 @default(0)
  totalLaborCost        Float                 @default(0)
  totalOverheadCost     Float                 @default(0)
  totalTheoreticalCost  Float                 @default(0)
  approvedAt            DateTime?
  approvedBy            String?
  notes                 String?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  finishedItem          InventoryItem         @relation("UretimBomFinishedItem", fields: [finishedItemId], references: [id], onDelete: Cascade)
  components            UretimBomItem[]
  routings              UretimRoutingHeader[]
  revisionLogs          UretimBomRevisionLog[]

  @@index([finishedItemId])
  @@index([status])
  @@index([branchId])
  @@index([isActive])
}

model UretimBomItem {
  id                    String                @id @default(uuid())
  bomId                 String
  componentItemId       String
  lineNumber            Int                   @default(10)
  quantity              Float
  unit                  String                @default("Adet")
  unitConversionFactor  Float                 @default(1.0)
  scrapPercent          Float                 @default(0)
  isPhantom             Boolean               @default(false)
  isVariantSpecific     Boolean               @default(false)
  variantKey            String?
  operationSequence     Int?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  bom                   UretimBomHeader       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItem         InventoryItem         @relation("UretimBomComponentItem", fields: [componentItemId], references: [id], onDelete: Cascade)
  substitutes           UretimBomSubstitute[]
  operationAllocations  UretimOperationMaterial[]

  @@index([bomId])
  @@index([componentItemId])
  @@index([operationSequence])
}

model UretimBomSubstitute {
  id                    String                @id @default(uuid())
  bomItemId             String
  substituteItemId      String
  priority              Int                   @default(1)
  substitutionRatio     Float                 @default(1.0)
  isMandatoryApproval   Boolean               @default(false)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  bomItem               UretimBomItem         @relation(fields: [bomItemId], references: [id], onDelete: Cascade)
  substituteItem        InventoryItem         @relation("UretimBomSubstituteItem", fields: [substituteItemId], references: [id], onDelete: Cascade)

  @@index([bomItemId])
  @@index([substituteItemId])
}

model UretimBomRevisionLog {
  id                    String                @id @default(uuid())
  bomId                 String
  fromRevision          String
  toRevision            String
  action                String                @default("UPDATE") // CREATE, APPROVE, REVISE, OBSOLETE, COPY
  changeSummary         String
  diffSnapshotJson      String?
  changedBy             String
  changedAt             DateTime              @default(now())

  bom                   UretimBomHeader       @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([changedAt])
}

model UretimRoutingHeader {
  id                    String                @id @default(uuid())
  branchId              String?
  bomId                 String?
  finishedItemId        String
  code                  String                @unique
  name                  String
  revision              String                @default("01")
  status                String                @default("DRAFT") // DRAFT, APPROVED, OBSOLETE
  totalSetupTimeMinutes Float                 @default(0)
  totalRunTimeMinutes   Float                 @default(0)
  totalHourlyCost       Float                 @default(0)
  totalRoutingCost      Float                 @default(0)
  approvedAt            DateTime?
  approvedBy            String?
  notes                 String?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  bom                   UretimBomHeader?      @relation(fields: [bomId], references: [id], onDelete: SetNull)
  finishedItem          InventoryItem         @relation("UretimRoutingFinishedItem", fields: [finishedItemId], references: [id], onDelete: Cascade)
  operations            UretimOperation[]

  @@index([finishedItemId])
  @@index([bomId])
  @@index([status])
  @@index([branchId])
}

model UretimOperation {
  id                         String                                @id @default(uuid())
  routingId                  String
  operationNumber            Int                                   @default(10)
  name                       String
  description                String?
  workCenterId               String
  setupTimeMinutes           Float                                 @default(0)
  runTimeMinutes             Float                                 @default(0)
  waitOrTransportTimeMinutes Float                                 @default(0)
  workerCount                Int                                   @default(1)
  isSubcontracted            Boolean                               @default(false)
  subcontractorName          String?
  subcontractUnitCost        Float                                 @default(0)
  isQualityControlPoint      Boolean                               @default(false)
  qualityInspectionType      String?
  calculatedHourlyCost       Float                                 @default(0)
  totalOperationCost         Float                                 @default(0)
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt

  routing                    UretimRoutingHeader                   @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenter                 UretimWorkCenter                      @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  alternativeWorkCenters     UretimOperationAlternativeWorkCenter[]
  materialAllocations        UretimOperationMaterial[]

  @@index([routingId])
  @@index([workCenterId])
  @@index([operationNumber])
}

model UretimOperationAlternativeWorkCenter {
  id                    String            @id @default(uuid())
  operationId           String
  workCenterId          String
  priority              Int               @default(1)
  efficiencyFactor      Float             @default(1.0)
  notes                 String?

  operation             UretimOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  workCenter            UretimWorkCenter  @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([workCenterId])
}

model UretimOperationMaterial {
  id                    String            @id @default(uuid())
  operationId           String
  bomItemId             String
  consumptionTiming     String            @default("START") // START, END, CONTINUOUS
  notes                 String?

  operation             UretimOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  bomItem               UretimBomItem     @relation(fields: [bomItemId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([bomItemId])
}

// ─────────────────────────────────────────────────────────────
// FAZ 4: MRP (MALZEME İHTİYAÇ PLANLAMASI) & MPS (ANA ÜRETİM ÇİZELGESİ)
// ─────────────────────────────────────────────────────────────

model UretimMpsPlan {
  id               String              @id @default(uuid())
  branchId         String?
  code             String              @unique
  name             String
  revision         String              @default("1.0")
  status           String              @default("DRAFT") // DRAFT, APPROVED, OBSOLETE
  bucketType       String              @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  horizonDays      Int                 @default(90)
  frozenDays       Int                 @default(14)
  isWhatIfScenario Boolean             @default(false)
  scenarioName     String?
  basePlanId       String?
  notes            String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items            UretimMpsPlanItem[]
  mrpRuns          UretimMrpRun[]

  @@index([branchId])
  @@index([status])
  @@index([basePlanId])
}

model UretimMpsPlanItem {
  id                   String        @id @default(uuid())
  mpsPlanId            String
  itemId               String
  periodIndex          Int           @default(0)
  periodStartDate      DateTime
  periodEndDate        DateTime
  forecastQty          Float         @default(0)
  salesOrderQty        Float         @default(0)
  grossRequirement     Float         @default(0)
  scheduledReceipts    Float         @default(0)
  plannedProductionQty Float         @default(0)
  projectedOnHand      Float         @default(0)
  atpQty               Float         @default(0)
  notes                String?

  mpsPlan              UretimMpsPlan @relation(fields: [mpsPlanId], references: [id], onDelete: Cascade)
  item                 InventoryItem @relation("UretimMpsPlanItemItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@index([mpsPlanId])
  @@index([itemId])
  @@index([periodIndex])
}

model UretimMrpRun {
  id                   String                  @id @default(uuid())
  branchId             String?
  mpsPlanId            String?
  runCode              String                  @unique
  runType              String                  @default("FULL_REGENERATION") // FULL_REGENERATION, NET_CHANGE
  status               String                  @default("RUNNING") // RUNNING, COMPLETED, FAILED
  startedAt            DateTime                @default(now())
  completedAt          DateTime?
  totalItemsPlanned    Int                     @default(0)
  totalOrdersGenerated Int                     @default(0)
  totalActionMessages  Int                     @default(0)
  executionTimeMs      Int                     @default(0)
  errorMessage         String?
  triggeredBy          String                  @default("SYSTEM")
  parametersJson       String?
  createdAt            DateTime                @default(now())

  mpsPlan              UretimMpsPlan?          @relation(fields: [mpsPlanId], references: [id], onDelete: SetNull)
  plannedOrders        UretimMrpPlannedOrder[]
  actionMessages       UretimMrpActionMessage[]

  @@index([branchId])
  @@index([mpsPlanId])
  @@index([status])
}

model UretimMrpPlannedOrder {
  id                 String                   @id @default(uuid())
  mrpRunId           String
  itemId             String
  orderType          String // PURCHASE, PRODUCTION, TRANSFER
  orderNumber        String
  orderStatus        String                   @default("PLANNED") // PLANNED, APPROVED, CONVERTED, REJECTED
  sourceDocumentType String                   @default("MPS") // MPS, SALES_ORDER, SAFETY_STOCK, BOM_DEPENDENT
  sourceDocumentId   String?
  quantity           Float
  unit               String                   @default("Adet")
  releaseDate        DateTime
  dueDate            DateTime
  supplierId         String?
  bomId              String?
  routingId          String?
  convertedDocType   String? // PURCHASE_REQUISITION, WORK_ORDER
  convertedDocId     String?
  peggingJson        String?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  mrpRun             UretimMrpRun             @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  item               InventoryItem            @relation("UretimMrpPlannedOrderItem", fields: [itemId], references: [id], onDelete: Cascade)
  actionMessages     UretimMrpActionMessage[]

  @@index([mrpRunId])
  @@index([itemId])
  @@index([orderType])
  @@index([orderStatus])
  @@index([releaseDate])
  @@index([dueDate])
}

model UretimMrpActionMessage {
  id              String                 @id @default(uuid())
  mrpRunId        String
  itemId          String
  plannedOrderId  String?
  actionType      String // EXPEDITE, DEFER, CANCEL, PAST_DUE, INSUFFICIENT_LEAD_TIME, SAFETY_STOCK_VIOLATION
  severity        String                 @default("WARNING") // INFO, WARNING, CRITICAL
  suggestedDate   DateTime?
  suggestedQty    Float?
  message         String
  isResolved      Boolean                @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime               @default(now())

  mrpRun          UretimMrpRun           @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  item            InventoryItem          @relation("UretimMrpActionMessageItem", fields: [itemId], references: [id], onDelete: Cascade)
  plannedOrder    UretimMrpPlannedOrder? @relation(fields: [plannedOrderId], references: [id], onDelete: SetNull)

  @@index([mrpRunId])
  @@index([itemId])
  @@index([actionType])
  @@index([severity])
  @@index([isResolved])
}

// ─────────────────────────────────────────────────────────────
// FAZ 5: ÜRETİM/İŞ EMRİ (WORK ORDERS) & ATÖLYE İCRA (SHOP FLOOR)
// ─────────────────────────────────────────────────────────────

model UretimWorkOrder {
  id                      String                     @id @default(uuid())
  branchId                String?
  workOrderNumber         String                     @unique
  sourceType              String                     @default("MANUAL") // MANUAL, SALES_ORDER, MRP
  sourceDocumentId        String?
  sourceDocumentNumber    String?
  itemId                  String
  bomId                   String?
  routingId               String?
  bomSnapshotJson         String?
  routingSnapshotJson     String?
  plannedQuantity         Float
  producedQuantity        Float                      @default(0)
  scrapQuantity           Float                      @default(0)
  unit                    String                     @default("Adet")
  status                  String                     @default("PLANNED") // PLANNED, APPROVED, RELEASED, IN_PROGRESS, PAUSED, COMPLETED, CLOSED, CANCELLED
  priority                String                     @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  warehouseId             String
  productionWarehouseId   String?
  plannedStartDate        DateTime
  plannedDueDate          DateTime
  actualStartDate         DateTime?
  actualEndDate           DateTime?
  closedAt                DateTime?
  closedBy                String?
  lotNumber               String?
  parentWorkOrderId       String?
  theoreticalMaterialCost Float                      @default(0)
  theoreticalLaborCost    Float                      @default(0)
  theoreticalOverheadCost Float                      @default(0)
  theoreticalTotalCost    Float                      @default(0)
  actualMaterialCost      Float                      @default(0)
  actualLaborCost         Float                      @default(0)
  actualOverheadCost      Float                      @default(0)
  actualScrapCost         Float                      @default(0)
  actualTotalCost         Float                      @default(0)
  costVariance            Float                      @default(0)
  notes                   String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  item                    InventoryItem              @relation("UretimWorkOrderItem", fields: [itemId], references: [id], onDelete: Cascade)
  operations              UretimWorkOrderOperation[]
  materials               UretimWorkOrderMaterial[]
  stoppages               UretimWorkOrderStoppage[]
  laborLogs               UretimWorkOrderLabor[]
  iotRecords              UretimIotStaging[]
  scheduledTasks          UretimScheduledTask[]
  capacityAlerts          UretimCapacityAlert[]
  qualityInspections      UretimQualityInspection[]
  qualityNcrs             UretimQualityNcr[]

  @@index([branchId])
  @@index([itemId])
  @@index([status])
  @@index([priority])
  @@index([sourceType])
  @@index([sourceDocumentId])
  @@index([plannedDueDate])
}

model UretimWorkOrderOperation {
  id                   String                     @id @default(uuid())
  workOrderId          String
  operationNumber      Int                        @default(10)
  name                 String
  description          String?
  workCenterId         String?
  operatorUserId       String?
  status               String                     @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, SKIPPED
  setupTimeMinutes     Float                      @default(0)
  plannedRunMinutes    Float                      @default(0)
  actualRunMinutes     Float                      @default(0)
  actualMachineMinutes Float                      @default(0)
  plannedQuantity      Float
  producedQuantity     Float                      @default(0)
  scrapQuantity        Float                      @default(0)
  scrapReasonCode      String?
  notes                String?
  actualStartDate      DateTime?
  actualEndDate        DateTime?
  scheduledStartDate   DateTime?
  scheduledEndDate     DateTime?
  isLocked             Boolean                    @default(false)
  sequenceNumber       Int                        @default(0)
  isQualityControlPoint Boolean                   @default(false)
  qualityInspectionStatus String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  workOrder            UretimWorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workCenter           UretimWorkCenter?          @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  stoppages            UretimWorkOrderStoppage[]
  laborLogs            UretimWorkOrderLabor[]
  materials            UretimWorkOrderMaterial[]
  scheduledTasks       UretimScheduledTask[]
  capacityAlerts       UretimCapacityAlert[]
  qualityInspections   UretimQualityInspection[]

  @@index([workOrderId])
  @@index([workCenterId])
  @@index([status])
  @@index([operatorUserId])
}

model UretimWorkOrderMaterial {
  id                String                    @id @default(uuid())
  workOrderId       String
  operationId       String?
  itemId            String
  plannedQuantity   Float
  reservedQuantity  Float                     @default(0)
  consumedQuantity  Float                     @default(0)
  scrapQuantity     Float                     @default(0)
  unit              String                    @default("Adet")
  unitCost          Float                     @default(0)
  totalCost         Float                     @default(0)
  consumptionMethod String                    @default("MANUAL") // MANUAL, BACKFLUSH
  lotNumber         String?
  isOverConsumed    Boolean                   @default(false)
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  workOrder         UretimWorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operation         UretimWorkOrderOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  item              InventoryItem             @relation("UretimWorkOrderMaterialItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([operationId])
  @@index([itemId])
}

model UretimWorkOrderLabor {
  id              String                   @id @default(uuid())
  workOrderId     String
  operationId     String
  userId          String
  userName        String?
  durationMinutes Float
  hourlyRate      Float                    @default(0)
  totalLaborCost  Float                    @default(0)
  startedAt       DateTime
  endedAt         DateTime?
  notes           String?
  createdAt       DateTime                 @default(now())

  workOrder       UretimWorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operation       UretimWorkOrderOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([operationId])
  @@index([userId])
}

model UretimWorkOrderStoppage {
  id              String                   @id @default(uuid())
  workOrderId     String
  operationId     String
  workCenterId    String?
  reasonCode      String // ARIZA, BAKIM, MALZEME_BEKLEME, AYAR_KALIBRASYON, ELEKTRIK_KESINTISI, MOLA, DIGER
  description     String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Float                    @default(0)
  reportedBy      String
  isResolved      Boolean                  @default(false)
  createdAt       DateTime                 @default(now())

  workOrder       UretimWorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operation       UretimWorkOrderOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([operationId])
  @@index([reasonCode])
}

model UretimIotStaging {
  id             String           @id @default(uuid())
  deviceId       String
  deviceType     String           @default("PLC") // PLC, SCADA, SCALE, BARCODE_STATION, SENSOR
  workOrderId    String?
  operationId    String?
  metricType     String // PRODUCTION_COUNT, SCRAP_COUNT, CYCLE_TIME, WEIGHT, TEMPERATURE, STOPPAGE
  metricValue    Float
  unit           String?
  rawPayloadJson String?
  status         String           @default("PENDING") // PENDING, PROCESSED, REJECTED
  errorMessage   String?
  receivedAt     DateTime         @default(now())
  processedAt    DateTime?

  workOrder      UretimWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([workOrderId])
  @@index([status])
  @@index([receivedAt])
}

// ─────────────────────────────────────────────────────────────
// FAZ 6: KAPASİTE PLANLAMA & ÇİZELGELEME (CRP & ADVANCED SCHEDULING)
// ─────────────────────────────────────────────────────────────

model UretimCapacityPlan {
  id                        String                   @id @default(uuid())
  branchId                  String?
  code                      String                   @unique
  name                      String
  startDate                 DateTime
  endDate                   DateTime
  schedulingMode            String                   @default("FINITE") // INFINITE, FINITE
  schedulingDirection       String                   @default("FORWARD") // FORWARD, BACKWARD
  priorityRule              String                   @default("EDD") // EDD, FCFS, CR, PRIORITY
  status                    String                   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  totalLoadHours            Float                    @default(0)
  totalCapacityHours        Float                    @default(0)
  bottleneckWorkCenterId    String?
  overloadedWorkCentersJson String?
  notes                     String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  items                     UretimCapacityPlanItem[]
  scheduledTasks            UretimScheduledTask[]

  @@index([branchId])
  @@index([status])
}

model UretimCapacityPlanItem {
  id                     String             @id @default(uuid())
  planId                 String
  workCenterId           String
  periodDate             String
  availableCapacityHours Float              @default(0)
  plannedLoadHours       Float              @default(0)
  mrpLoadHours           Float              @default(0)
  totalLoadHours         Float              @default(0)
  loadPercentage         Float              @default(0)
  isOverloaded           Boolean            @default(false)
  operationCount         Int                @default(0)
  createdAt              DateTime           @default(now())

  plan                   UretimCapacityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  workCenter             UretimWorkCenter   @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([workCenterId])
  @@index([periodDate])
}

model UretimScheduledTask {
  id             String                    @id @default(uuid())
  planId         String?
  workOrderId    String
  operationId    String
  workCenterId   String
  setupMinutes   Float                     @default(0)
  runMinutes     Float                     @default(0)
  totalMinutes   Float                     @default(0)
  scheduledStart DateTime
  scheduledEnd   DateTime
  sequenceOrder  Int                       @default(0)
  isLocked       Boolean                   @default(false)
  isDelayed      Boolean                   @default(false)
  delayMinutes   Float                     @default(0)
  status         String                    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  plan           UretimCapacityPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  workOrder      UretimWorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operation      UretimWorkOrderOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  workCenter     UretimWorkCenter          @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([workOrderId])
  @@index([workCenterId])
  @@index([operationId])
  @@index([scheduledStart])
}

model UretimCapacityAlert {
  id              String                    @id @default(uuid())
  branchId        String?
  workCenterId    String?
  workOrderId     String?
  operationId     String?
  alertType       String // OVERLOAD, BOTTLENECK, DELAY, CAPACITY_EXCEEDED, DEPENDENCY_CONFLICT
  severity        String                    @default("WARNING") // INFO, WARNING, CRITICAL
  message         String
  loadPercentage  Float?
  periodDate      String?
  isAcknowledged  Boolean                   @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  createdAt       DateTime                  @default(now())

  workCenter      UretimWorkCenter?         @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  workOrder       UretimWorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operation       UretimWorkOrderOperation? @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([workCenterId])
  @@index([alertType])
  @@index([isAcknowledged])
}

model UretimCtpSimulation {
  id                          String        @id @default(uuid())
  branchId                    String?
  simulationNumber            String        @unique
  itemId                      String
  quantity                    Float
  requestedDueDate            DateTime?
  calculatedEarliestDueDate   DateTime
  isFeasible                  Boolean       @default(true)
  bottleneckWorkCenterId      String?
  criticalPathDays            Float         @default(0)
  simulatedScheduleJson       String?
  createdByUserId             String?
  createdAt                   DateTime      @default(now())

  item                        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model UretimOperationTimeVariance {
  id                       String           @id @default(uuid())
  operationId              String?
  workCenterId             String
  operationName            String
  plannedStandardMinutes   Float
  actualAverageMinutes     Float
  sampleCount              Int              @default(1)
  variancePercent          Float            @default(0)
  suggestedStandardMinutes Float
  isApplied                Boolean          @default(false)
  appliedAt                DateTime?
  appliedBy                String?
  createdAt                DateTime         @default(now())

  workCenter               UretimWorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([workCenterId])
  @@index([isApplied])
}

// ─────────────────────────────────────────────────────────────
// FAZ 7: ÜRETİM KALİTE KONTROL, MUAYENE, NCR & DÖF (CAPA)
