// -----------------------------------------
// CUSTOMER ENHANCED MODULES
// -----------------------------------------
model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  content    String
  noteType   String   @default("Arama") // Call, Meeting, Email, Visit
  reminderId String?  // Optional link to a reminder
  createdAt  DateTime @default(now())
