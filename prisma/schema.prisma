  updatedAt   DateTime @updatedAt

  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taskStatusHistories TaskStatusHistory[]
}

model TaskStatusHistory {
  id              String   @id @default(uuid())
  userId          String
  taskId          String
  contentCalendarId String?
  oldStatus       String
  newStatus       String
  timestamp       DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           CustomerTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contentCalendar ContentCalendar? @relation(fields: [contentCalendarId], references: [id], onDelete: SetNull)
}

model ContentCalendar {
  id            String   @id @default(uuid())
  branchId      String
  title         String
  description   String?
  scheduledDate DateTime
  status        String   @default("planned")
  customerName  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  files         File[]
  documents     CustomerDocument[]
  taskHistories TaskStatusHistory[]
  libraryFiles  LibraryFile[]
}

// -----------------------------------------
// İÇERİK TAKVİMİ YÖNETİM SİSTEMİ
// Ajans içerik üretim sürecini uçtan uca yönetir:
// İçerik planı → Çekim → Editlime → Onay → Yayın
// -----------------------------------------

// Ana içerik kaydı
model ContentItem {
  id          String   @id @default(uuid())
  branchId    String   // Hangi firma/şube

  // Temel bilgiler
  title       String
  caption     String?  // Sosyal medya açıklaması/metni
  description String?  // İç notlar, brief

  // Platform ve içerik tipi
  platforms   String   // JSON array: ["instagram","tiktok","youtube","facebook","linkedin","x","other"]
  contentType String   // reels | static_post | story | carousel | video | blog | other

  // Zamanlama
  scheduledDate DateTime  // Paylaşım tarihi
  scheduledTime String?   // Paylaşım saati (HH:mm formatı, string olarak saklanır)

  // Durum
  // draft | awaiting_shoot | in_editing | pending_approval | scheduled | published | cancelled | missed
  status      String   @default("draft")
  iptalOncesiDurum String?

  // Ekip atama — her rol için ayrı alan
  shooterId   String?  // Videoçekim uzmanı (User.id)
  editorId    String?  // Editör (User.id)
  managerId   String?  // Sosyal medya yöneticisi (User.id)
  designerId  String?  // Grafik tasarım uzmanı (User.id)

  // Çekim bağlantısı (opsiyonel)
  shootId     String?  // ProductionShoot.id

  // Müşteri onayı
  clientApprovalRequired Boolean @default(false)
  clientApprovalStatus   String? // pending | approved | rejected

  // Yayın takibi
  publishedUrl String?  // Yayınlanan içeriğin gerçek URL'i

  // Oluşturma bilgisi
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // İlişkiler
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shoot         ProductionShoot?    @relation(fields: [shootId], references: [id], onDelete: SetNull)
  media         ContentMedia[]
  statusHistory ContentStatusHistory[] @relation("ContentItemHistory")
  chatLinks     ContentChatLink[]   @relation("ContentItemChatLinks")
  revisions     RevisionRequest[]

  @@index([branchId, scheduledDate])
  @@index([branchId, status])
  @@index([shooterId])
  @@index([editorId])
  @@index([managerId])
  @@index([designerId])
}

// Çekim günü kaydı — bir çekim gününde birden fazla içerik üretilebilir
model ProductionShoot {
  id          String   @id @default(uuid())
  branchId    String

  shootDate   DateTime // Çekim tarihi
  shootTime   String?  // Çekim saati (HH:mm)
  location    String?  // Mekan/adres

  // Atanan kişiler (JSON array of user IDs)
  videographerIds String? // JSON: ["userId1","userId2"]

  // Durum
  // planned | shot | in_editing | completed | cancelled | postponed
  status      String   @default("planned")

  // Notlar
  equipmentNotes String? // Ekipman ve özel notlar

  // Oluşturma
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // İlişkiler
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  contentItems  ContentItem[]
  statusHistory ContentStatusHistory[] @relation("ShootHistory")
  chatLinks     ContentChatLink[]   @relation("ShootChatLinks")

  @@index([branchId, shootDate])
  @@index([branchId, status])
}

// Medya dosyaları — versiyon geçmişi destekli
model ContentMedia {
  id            String   @id @default(uuid())
  contentItemId String

  fileUrl       String   // Dosya URL'i (/api/uploads/...)
  fileType      String   // image | video | document
  mimeType      String?  // image/jpeg, video/mp4 vb.
  fileName      String?  // Orijinal dosya adı
  fileSize      BigInt?  // Byte cinsinden boyut
  thumbnailUrl  String?  // Video/belge küçük resmi

  version       Int      @default(1)           // Versiyon numarası
  isFinal       Boolean  @default(false)       // Bu versiyon final mi?
  versionNote   String?  // Versiyon notu (ör. "1. revizyon")

  uploadedById  String
  uploadedAt    DateTime @default(now())

  // İlişkiler
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([contentItemId, version])
}

// Durum değişikliği geçmişi — ContentItem ve ProductionShoot için ortak (polymorphic)
model ContentStatusHistory {
  id          String   @id @default(uuid())

  // Polimorfik — entityType + entityId ile hedef belirlenir
  entityType  String   // "content_item" | "production_shoot"
  entityId    String   // İlgili kaydın ID'si

  oldStatus   String
  newStatus   String
  changedById String   // Kim değiştirdi (User.id)
  changedAt   DateTime @default(now())
  note        String?  // Opsiyonel açıklama (ör. "İptal sebebi: hava durumu")

  // Polimorfik ilişkiler — her iki modele de bağlanabilir
  contentItem   ContentItem?     @relation("ContentItemHistory",   fields: [entityId], references: [id], onDelete: Cascade, map: "csh_content_item_fk")
  productionShoot ProductionShoot? @relation("ShootHistory",       fields: [entityId], references: [id], onDelete: Cascade, map: "csh_shoot_fk")

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([changedAt])
}

// Chat entegrasyon kaydı — tek tuşla gönderilen görev mesajlarının referansı
model ContentChatLink {
  id            String   @id @default(uuid())

  // Hedef — ContentItem veya ProductionShoot'a bağlı
  contentItemId String?
  shootId       String?

  sentToUserId    String   // Kime gönderildi
  chatMessageId   String?  // Mevcut chat sistemindeki mesaj ID'si
  chatConversationId String? // Hangi konuşmada gönderildi

  sentById      String
  sentAt        DateTime @default(now())

  // İlişkiler
  contentItem   ContentItem?     @relation("ContentItemChatLinks", fields: [contentItemId], references: [id], onDelete: Cascade)
  shoot         ProductionShoot? @relation("ShootChatLinks",       fields: [shootId],       references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([shootId])
  @@index([sentToUserId])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  name       String
  role       String?  // Decision maker, Technical contact etc.
  phone      String?
  email      String?
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// HR (Human Resources) MODULES
// -----------------------------------------
model Candidate {
  id              String   @id @default(uuid())
  branchId        String
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  position        String?
  status          String   @default("Aday") // Candidate, Active, Ex-Employee, Blacklist
  applicationDate DateTime?
  startDate       DateTime?
  leaveDate       DateTime?
  salaryRange     String?
  expectationNote String?
  rating          Int      @default(0) // 1-5
  kanbanStatus    String   @default("Basvurdu") // Applied, Interview, Offer, Hired, Rejected
  department      String?  // Sales, Technical, Accounting etc.
  priority        String   @default("Normal") // Urgent, Normal, Pending
  skills          String?  // JSON list
  location        String?
  experienceYears Int?
  education       String?
  
  photoUrl        String?
  
  documents       CandidateDocument[]
  chats           CandidateChat[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model CandidateDocument {
  id          String   @id @default(uuid())
  candidateId String
  name        String
  url         String
  type        String   @default("CV") // CV, Portfolio, ID etc.
  version     Int      @default(1)
  notes       String?
  aiData      String?  // AI parsed data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateChat {
  id              String   @id @default(uuid())
  candidateId     String
  type            String   @default("Telefon") // Phone, Email, WhatsApp
  content         String?
  fileUrl         String?
  timestamp       DateTime @default(now())
  nextContactDate DateTime?
  
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// TAKVIM - RANDEVU MODELI
// -----------------------------------------
model Appointment {
  id           String    @id @default(uuid())
  branchId     String
  title        String
  description  String?
  userId       String?   // Optional: user specific calendar
  customerId   String?   // Optional: customer related appointment
  customerName String?   // Customer name (denormalized for fast display)
  startDate    DateTime
  endDate      DateTime?
  allDay       Boolean   @default(false)
  color        String    @default("#3B82F6") // Calendar appearance color
  location     String?
  status       String    @default("scheduled") // scheduled, completed, cancelled
  approvalStep String?
  slaDeadline  DateTime?
  assignedTo   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, startDate])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiRevisionAnalysis {
  id            String   @id @default(uuid())
  branchId      String
  uploadedById  String
  customerName  String?
  sourceText    String
  summary       String
  preferences   Json
  redFlags      Json
  createdAt     DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model NightScanResult {
  id                String   @id @default(uuid())
  branchId          String
  companyName       String
  industry          String?
  websiteUrl        String?
  instagramUrl      String?
  googleMapsUrl     String?
  painPoints        String?  // JSON array
  matchedServices   String?  // JSON array
  fieldNote         String?
  scoreTemp         String?
  status            String   @default("pending") // pending, approved, dismissed
  scanDate          DateTime @default(now())
  createdAt         DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
