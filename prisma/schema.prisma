// -----------------------------------------
// AJANS KÜTÜPHANESİ MODÜLÜ
// -----------------------------------------

model LibraryFolder {
  id             String   @id @default(uuid())
  branchId       String
  name           String
  parentFolderId String?
  createdById    String
  isStarred      Boolean  @default(false)
  isTrashed      Boolean  @default(false)
  trashedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("LibraryFolderCreator", fields: [createdById], references: [id])
  parentFolder  LibraryFolder?      @relation("FolderChildren", fields: [parentFolderId], references: [id])
  childFolders  LibraryFolder[]     @relation("FolderChildren")
  files         LibraryFile[]
  permissions   LibraryFilePermission[]
  activityLogs  LibraryActivityLog[]

  @@index([branchId, parentFolderId])
  @@index([branchId, isTrashed])
}

model LibraryFile {
  id                 String    @id @default(uuid())
  branchId           String
  folderId           String?
  originalName       String
  mimeType           String
  sizeBytes          BigInt
  checksumSha256     String
  storagePath        String
  uploadedById       String
  version            Int       @default(1)
  parentFileId       String?   // Versiyonlama: önceki versiyon
  derivedFromFileId  String?   // Converter çıktısı: kaynak dosya
  isStarred          Boolean   @default(false)
  isTrashed          Boolean   @default(false)
  trashedAt          DateTime?
  description        String?
  tags               String?   // JSON array
  contentCalendarId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch            Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  folder            LibraryFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy        User                    @relation("LibraryFileUploader", fields: [uploadedById], references: [id])
  parentFile        LibraryFile?            @relation("FileVersions", fields: [parentFileId], references: [id])
  fileVersions      LibraryFile[]           @relation("FileVersions")
  derivedFrom       LibraryFile?            @relation("DerivedFiles", fields: [derivedFromFileId], references: [id])
  derivedFiles      LibraryFile[]           @relation("DerivedFiles")
  permissions       LibraryFilePermission[]
  conversionJobs    LibraryConversionJob[]  @relation("SourceFile")
  outputJobs        LibraryConversionJob[]  @relation("OutputFile")
  activityLogs      LibraryActivityLog[]
  contentCalendar   ContentCalendar?        @relation(fields: [contentCalendarId], references: [id], onDelete: SetNull)

  @@index([branchId, folderId])
  @@index([branchId, isTrashed])
  @@index([branchId, mimeType])
  @@index([checksumSha256])
}

model LibraryFilePermission {
  id              String   @id @default(uuid())
  fileId          String?
  folderId        String?
  userId          String?
  roleId          String?
  permissionLevel String   @default("view") // view, comment, edit
  grantedById     String
  createdAt       DateTime @default(now())

  file      LibraryFile?   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder    LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  grantedBy User           @relation("LibraryPermissionGranter", fields: [grantedById], references: [id])

  @@index([fileId])
  @@index([folderId])
  @@index([userId])
}

model LibraryConversionJob {
  id             String    @id @default(uuid())
  sourceFileId   String
  targetFormat   String
  status         String    @default("queued") // queued, processing, completed, failed
  progress       Int       @default(0)
  outputFileId   String?
  errorMessage   String?
  requestedById  String
  options        String?   // JSON: quality, resolution vb. kullanıcı seçimleri
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  sourceFile    LibraryFile  @relation("SourceFile", fields: [sourceFileId], references: [id], onDelete: Cascade)
  outputFile    LibraryFile? @relation("OutputFile", fields: [outputFileId], references: [id])
  requestedBy   User         @relation("LibraryJobRequester", fields: [requestedById], references: [id])

  @@index([status])
  @@index([sourceFileId])
  @@index([requestedById])
}

model LibraryActivityLog {
  id         String   @id @default(uuid())
  branchId   String
  fileId     String?
  folderId   String?
  userId     String
  action     String   // upload, download, delete, restore, convert, share, move, rename, copy
  details    String?  // JSON: ek bilgi
  createdAt  DateTime @default(now())

  file      LibraryFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  folder    LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user      User           @relation("LibraryActivityUser", fields: [userId], references: [id])

  @@index([branchId, createdAt])
  @@index([fileId])
  @@index([userId])
}

model LibraryUploadChunk {
  id         String   @id @default(uuid())
  uploadId   String
  chunkIndex Int
  totalChunks Int
  fileName   String
  mimeType   String
  chunkPath  String
  createdAt  DateTime @default(now())

  @@unique([uploadId, chunkIndex])
  @@index([uploadId])
}

// -----------------------------------------
// İÇERİK MAĞAZASI (CONTENT STORE) MODÜLÜ
// -----------------------------------------

model Niche {
  id            String         @id @default(uuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  contentStores ContentStore[]
}

model ContentStore {
  id                  String                  @id @default(uuid())
  url                 String
  originalName        String
  mimeType            String
  sizeBytes           BigInt
  type                String                  // "IMAGE", "VIDEO", "OTHER"
  nicheId             String
  niche               Niche                   @relation(fields: [nicheId], references: [id])
  uploadedById        String
  uploadedBy          User                    @relation("ContentStoreUploadedBy", fields: [uploadedById], references: [id])
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  
  // Yeni eklenen alanlar
  status              String                  @default("approved") // draft, pending_approval, approved, rejected
  fileHash            String                  @default("")
  currentVersionNumber Int                    @default(1)
  approvedById        String?
  approvedBy          User?                   @relation("ContentStoreApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  rejectionReason     String?
  viewCount           Int                     @default(0)
  downloadCount       Int                     @default(0)
  duplicateOfContentId String?
  duplicateOf         ContentStore?           @relation("ContentDuplicates", fields: [duplicateOfContentId], references: [id], onDelete: SetNull)
  duplicates          ContentStore[]          @relation("ContentDuplicates")
  versions            ContentVersion[]
  analyticsEvents     ContentAnalyticsEvent[]

  @@index([nicheId])
  @@index([type])
  @@index([status])
  @@index([fileHash])
}

model ContentVersion {
  id             String       @id @default(uuid())
  contentStoreId String
  contentStore   ContentStore @relation(fields: [contentStoreId], references: [id], onDelete: Cascade)
  versionNumber  Int
  url            String
  fileHash       String
  fileSize       BigInt
  uploadedById   String
  uploadedBy     User         @relation("ContentVersionUploadedBy", fields: [uploadedById], references: [id])
  changeNote     String?
  createdAt      DateTime     @default(now())

  @@index([contentStoreId])
}

model ContentAnalyticsEvent {
  id             String       @id @default(uuid())
  contentStoreId String
  contentStore   ContentStore @relation(fields: [contentStoreId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("ContentAnalyticsEventUser", fields: [userId], references: [id], onDelete: SetNull)
  eventType      String       // "view", "download"
  createdAt      DateTime     @default(now())

  @@index([contentStoreId, createdAt])
}

model RevisionRequest {
  id             String    @id @default(uuid())
  contentItemId  String
  revisionNumber Int
  message        String
  createdById    String
  createdAt      DateTime  @default(now())
  completedById  String?
  completedAt    DateTime?
  status         String    @default("bekliyor") // bekliyor | tamamlandi

  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdBy      User        @relation("CreatedRevisions", fields: [createdById], references: [id])
  completedBy    User?       @relation("CompletedRevisions", fields: [completedById], references: [id])

  @@index([contentItemId])
}


// -----------------------------------------
// G�REV Y�NET�M (TASK) MOD�L�
// -----------------------------------------

model InternalTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  attachments String?  @default("[]") // JSON array of uploaded file URLs
  
  assignerId  String
  assigneeId  String
  
  assigner    User     @relation("TasksAssigned", fields: [assignerId], references: [id])
  assignee    User     @relation("TasksReceived", fields: [assigneeId], references: [id])
  
  statusLogs  InternalTaskStatusLog[]
  activeTasks ActiveTask[]
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InternalTaskStatusLog {
  id         String       @id @default(uuid())
  taskId     String
  userId     String
  status     String       // "START" | "PAUSE" | "RESUME" | "COMPLETE"
  startedAt  DateTime     @default(now())
  endedAt    DateTime?
  note       String?

  task       InternalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
  @@index([startedAt])
}

model ActiveTask {
  id         String       @id @default(uuid())
  userId     String       @unique
  taskId     String
  startedAt  DateTime     @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       InternalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetLog {
  id        String   @id @default(uuid())
  userId    String
  resetBy   String
  resetAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Module {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  sortOrder Int      @default(0)
}

model EodReport {
  id             String              @id @default(uuid())
  userId         String
  reportDate     DateTime            // Date of EOD (normalized to 00:00:00)
  status         String              @default("draft") // draft | submitted
  autoContent    String              // JSON string of Branch groupings: Array of { branchId, branchName, items: string[] }
  manualContent  String              @default("")      // Non-ERP comments
  submittedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs      EodReportAuditLog[]

  @@unique([userId, reportDate])
}

model EodReportAuditLog {
  id        String    @id @default(uuid())
  reportId  String
  userId    String
  action    String    // create_draft | update_draft | submit
  details   String?   // JSON representation of diff or log details
  createdAt DateTime  @default(now())

  report    EodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id             String                    @id @default(uuid())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  reporterUserId String
  reporter       User                      @relation("ReportedTickets", fields: [reporterUserId], references: [id], onDelete: Cascade)
  title          String
  description    String
  status         String                    @default("open") // open, in_progress, needs_info, resolved, wont_fix, closed
  priority       String                    @default("medium") // low, medium, high, critical
  category       String                    @default("other") // ui_bug, backend_error, missing_feature, performance, data_issue, other
  pageUrl        String
  moduleName     String
  screenshotUrl  String?
  browserInfo    Json                      // JSON: user agent, screen resolution, viewport
  consoleLogs    Json                      // JSON array: console errors and warnings
  networkLogs    Json                      // JSON array: failed API requests (sensitive data masked)
  appVersion     String?
  assignedTo     String?
  assignedUser   User?                     @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  resolutionNote String?
  internalComments Json                    // JSON array of comment objects: [{ id, userId, fullName, comment, createdAt }]
  isDeleted      Boolean                   @default(false)
  attachments    SupportTicketAttachment[]

  @@index([status, priority])
  @@index([reporterUserId, isDeleted])
  @@map("support_tickets")
}

model SupportTicketAttachment {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime      @default(now())

  @@map("support_ticket_attachments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// WHATSAPP AI AGENT TABLOLARI
// ═══════════════════════════════════════════════════════════════════════════════

model AiKnowledgeChunk {
  id        String   @id @default(cuid())
  source    String   // "business_doc" | "whatsapp_history" | "product_catalog"
  sourceRef String?  // Dosya adı veya customerId referansı
  content   String   // Ham metin chunk (500-1000 karakter)
  embeddingJson String? // JSON float array [0.1, 0.2, ...] geçici olarak
  contentHash   String  // SHA-256 hash — idempotent ingestion için
  metadata      Json?   // Ek bağlam: { customerName, date, branchId }
  createdAt DateTime @default(now())

  @@index([source])
  @@index([sourceRef])
  @@index([contentHash])
}

model AiConversationMemory {
  id         String   @id @default(cuid())
  customerId String
  role       String   // "user" | "assistant" | "system"
  content    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model AiAgentLog {
  id                String   @id @default(cuid())
  customerId        String?
  incomingMessage   String
  retrievedContext  Json     // RAG'de bulunanlar, hangi chunk'lar kullanıldı
  toolCalls         Json?    // Çağrılan ERP tool'ları ve parametreleri
  generatedResponse String
  wasAutoSent       Boolean  @default(false)  // Gerçekten gönderildi mi (shadow mode = false)
  escalatedToHuman  Boolean  @default(false)
  escalationReason  String?
  latencyMs         Int
  llmProvider       String   // "anthropic" | "openai" | "ollama" | "gemini"
  shadowMode        Boolean  @default(true)   // Shadow mode'da mı üretildi
  createdAt         DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([wasAutoSent])
  @@index([escalatedToHuman])
  @@index([createdAt])
}

// FAQ Module
model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("Genel")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enterprise Geri Dönüşüm Kutusu (Polymorphic Trash Engine) Modeli
model TrashItem {
  id                String    @id @default(uuid())
  entityType        String    // "Customer", "Project", "Order", "LibraryFile", "InternalTask", "Finance" vb.
  entityId          String    // Orijinal kaydın ID'si
  title             String    // Kullanıcının göreceği başlık / isim
  payload           String    // Orijinal verinin tam JSON snapshot'ı (bağımlılıklar dahil)
  filePaths         String?   // Varsa fiziksel dosya yollarının JSON dizisi (["/uploads/a.pdf"])
  deletedByUserId   String
  deletedByFullName String
  branchId          String?
  deletedAt         DateTime  @default(now())
  expiresAt         DateTime  // Otomatik kalıcı silinme tarihi (30 gün varsayılan)
  status            String    @default("IN_TRASH") // "IN_TRASH", "RESTORED", "PURGED"

  user   User    @relation(fields: [deletedByUserId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([deletedByUserId])
  @@index([branchId])
  @@index([expiresAt])
  @@index([status])
}


// ═══════════════════════════════════════════════════════════════════════════════
// FAZ 1: ÇEKİRDEK STOK VE ENVANTER MİMARİSİ
// ═══════════════════════════════════════════════════════════════════════════════

model Warehouse {
  id               String   @id @default(uuid())
  branchId         String
  code             String   @unique
  name             String
  type             String   @default("MAIN") // MAIN, BRANCH_STORE, COLD_CHAIN, CONSIGNMENT, TRANSIT, QUARANTINE
  address          String?
  city             String?
  managerName      String?
  phone            String?
  capacityVolumeM3 Float    @default(1000)
  usedVolumeM3     Float    @default(0)
  capacityWeightKg Float    @default(50000)
  usedWeightKg     Float    @default(0)
  temperatureRange String?
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  zones            WarehouseZone[]
  bins             StorageBin[]
  stockBalances    StockBalance[]
  lotSerials       LotSerialRecord[]
  costLayers       CostLayer[]
  stockMovements   StockMovement[]
  licensePlates    LicensePlate[]
  countSessions    InventoryCountSession[]

  @@index([branchId])
  @@index([type])
}

model InventoryItem {
  id                String   @id @default(uuid())
  productId         String?  @unique
  sku               String   @unique
  barcode           String?
  gtin              String?
  rfidEpcPrefix     String?
  name              String
  description       String?
  category          String   @default("Genel")
  brand             String?
  itemType          String   @default("FINISHED_GOOD") // RAW_MATERIAL, SEMI_FINISHED, FINISHED_GOOD, MERCHANDISE, CONSUMABLE, MATRIX_PARENT, MATRIX_VARIANT
  parentItemId      String?
  variantAttributes String?  // JSON: {"renk": "Siyah", "beden": "L"}
  baseUnit          String   @default("Adet")
  valuationMethod   String   @default("FIFO") // FIFO, LIFO, WEIGHTED_AVERAGE, STANDARD
  standardCost      Float    @default(0)
  currentAvgCost    Float    @default(0)
  fifoUnitCost      Float    @default(0)
  lifoUnitCost      Float    @default(0)
  lastPurchaseCost  Float    @default(0)
  salesPrice        Float    @default(0)
  currency          String   @default("TRY")
  taxRate           Float    @default(20)
  trackLot          Boolean  @default(false)
  trackSerial       Boolean  @default(false)
  trackExpiry       Boolean  @default(false)
  shelfLifeDays     Int?
  abcClass          String   @default("A")
  xyzClass          String   @default("X")
  weightKg          Float    @default(0.5)
  volumeM3          Float    @default(0.01)
  minStockLevel     Float    @default(10)
  maxStockLevel     Float    @default(500)
  leadTimeDays      Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product                  Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  parentItem               InventoryItem?           @relation("MatrixVariants", fields: [parentItemId], references: [id], onDelete: Cascade)
  variants                 InventoryItem[]          @relation("MatrixVariants")
  stockBalances            StockBalance[]
  unitConversions          UnitConversion[]
  alternativesFrom         AlternativeProduct[]     @relation("SourceItemAlternatives")
  alternativesTo           AlternativeProduct[]     @relation("SubstituteItemAlternatives")
  lotSerials               LotSerialRecord[]
  bomHeaders               BomHeader[]              @relation("FinishedItemBoms")
  bomComponents            BomComponent[]           @relation("ComponentItemBoms")
  costLayers               CostLayer[]
  stockMovements           StockMovement[]
  reorderPolicies          ReorderPolicy[]
  consignmentStocks        ConsignmentStock[]
  demandForecasts          DemandForecastRecord[]
  transferOrderLines       TransferOrderLine[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  orderShipmentLines       OrderShipmentLine[]
  licensePlateContents     LicensePlateContent[]
  uretimProfile            UretimItemProfile?
  uretimBomHeaders         UretimBomHeader[]        @relation("UretimBomFinishedItem")
  uretimBomComponents      UretimBomItem[]          @relation("UretimBomComponentItem")
  uretimBomSubstitutes     UretimBomSubstitute[]    @relation("UretimBomSubstituteItem")
  uretimRoutings           UretimRoutingHeader[]    @relation("UretimRoutingFinishedItem")
  uretimMpsPlanItems       UretimMpsPlanItem[]      @relation("UretimMpsPlanItemItem")
  uretimMrpPlannedOrders   UretimMrpPlannedOrder[]  @relation("UretimMrpPlannedOrderItem")
  uretimMrpActionMessages  UretimMrpActionMessage[] @relation("UretimMrpActionMessageItem")
  uretimWorkOrders         UretimWorkOrder[]        @relation("UretimWorkOrderItem")
  uretimWorkOrderMaterials UretimWorkOrderMaterial[] @relation("UretimWorkOrderMaterialItem")
  uretimCtpSimulations     UretimCtpSimulation[]
  uretimQualityPlans       UretimQualityPlan[]
  uretimQualityInspections UretimQualityInspection[]
  uretimQualityNcrs        UretimQualityNcr[]
  uretimMachineSpareParts  UretimMachineSparePart[]
  uretimMaintenanceWorkOrderSpareParts UretimMaintenanceWorkOrderSparePart[]

  @@index([category])
  @@index([parentItemId])
  @@index([itemType])
  @@index([barcode])
}

model StockBalance {
  id             String   @id @default(uuid())
  itemId         String
  warehouseId    String
  storageBinId   String?
  binCode        String?
  onHandQty      Float    @default(0)
  reservedQty    Float    @default(0)
  availableQty   Float    @default(0)
  inTransitQty   Float    @default(0)
  quarantineQty  Float    @default(0)
  consignmentQty Float    @default(0)
  updatedAt      DateTime @updatedAt

  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  storageBin     StorageBin?   @relation(fields: [storageBinId], references: [id], onDelete: SetNull)

  @@unique([itemId, warehouseId, storageBinId])
  @@index([warehouseId])
  @@index([storageBinId])
}

model UnitConversion {
  id                String   @id @default(uuid())
  itemId            String
  fromUnit          String
  toUnit            String
  multiplier        Float
  barcode           String?
  weightKg          Float?
  volumeM3          Float?
  isDefaultPurchase Boolean  @default(false)
  isDefaultSales    Boolean  @default(false)
  createdAt         DateTime @default(now())

  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model AlternativeProduct {
  id                    String   @id @default(uuid())
  sourceItemId          String
  substituteItemId      String
  relationType          String   @default("EXACT_SUBSTITUTE") // EXACT_SUBSTITUTE, UPGRADE, DOWNGRADE, COMPATIBLE, CROSS_SELL
  priority              Int      @default(1)
  conversionRatio       Float    @default(1.0)
  priceDiffPercent      Float    @default(0)
  autoSuggestOnOutStock Boolean  @default(true)
  isBidirectional       Boolean  @default(true)
  notes                 String?
  createdAt             DateTime @default(now())

  sourceItem            InventoryItem @relation("SourceItemAlternatives", fields: [sourceItemId], references: [id], onDelete: Cascade)
  substituteItem        InventoryItem @relation("SubstituteItemAlternatives", fields: [substituteItemId], references: [id], onDelete: Cascade)

  @@index([sourceItemId])
  @@index([substituteItemId])
}

model LotSerialRecord {
  id                String    @id @default(uuid())
  itemId            String
  warehouseId       String
  binCode           String?
  lotNumber         String
  batchNumber       String?
  serialNumber      String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  supplierName      String?
  supplierLotNo     String?
  status            String    @default("AVAILABLE") // AVAILABLE, QUARANTINE, EXPIRED, RECALLED, CONSUMED, SOLD
  initialQty        Float     @default(0)
  remainingQty      Float     @default(0)
  unitCost          Float     @default(0)
  originDocType     String?
  originDocNo       String?
  qcStatus          String    @default("PASSED")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  item              InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  traceLogs         TraceabilityLog[]

  @@index([itemId, expiryDate])
  @@index([lotNumber])
  @@index([serialNumber])
  @@index([status])
}

model TraceabilityLog {
  id              String   @id @default(uuid())
  lotSerialId     String
  eventType       String   // SUPPLIER_RECEIPT, QC_INSPECTION, PUTAWAY, BOM_CONSUMPTION, PRODUCTION_OUTPUT, TRANSFER, PICK_PACK, CUSTOMER_SHIPMENT, RMA_RETURN, RECALL_HOLD
  eventDate       DateTime @default(now())
  quantity        Float
  fromLocation    String?
  toLocation      String?
  referenceDocNo  String?
  partnerName     String?
  operatorName    String?
  notes           String?

  lotSerial       LotSerialRecord @relation(fields: [lotSerialId], references: [id], onDelete: Cascade)

  @@index([lotSerialId, eventDate])
  @@index([referenceDocNo])
}

model BomHeader {
  id                   String   @id @default(uuid())
  finishedItemId       String
  code                 String   @unique
  name                 String
  version              String   @default("v1.0")
  outputQty            Float    @default(1)
  outputUnit           String   @default("Adet")
  laborCostPerBatch    Float    @default(0)
  overheadCostPerBatch Float    @default(0)
  scrapRatePercent     Float    @default(2.0)
  leadTimeHours        Float    @default(4.0)
  isActive             Boolean  @default(true)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  finishedItem         InventoryItem       @relation("FinishedItemBoms", fields: [finishedItemId], references: [id], onDelete: Cascade)
  components           BomComponent[]
  uretimItemProfiles   UretimItemProfile[] @relation("DefaultBomForItemProfile")

  @@index([finishedItemId])
}

model BomComponent {
  id               String  @id @default(uuid())
  bomId            String
  componentItemId  String
  quantity         Float
  unit             String  @default("Adet")
  scrapPercent     Float   @default(0)
  isOptional       Boolean @default(false)
  operationStep    String?
  notes            String?

  bom              BomHeader     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItem    InventoryItem @relation("ComponentItemBoms", fields: [componentItemId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([componentItemId])
}

model CostLayer {
  id            String   @id @default(uuid())
  itemId        String
  warehouseId   String
  lotNumber     String?
  receiptDocNo  String
  layerDate     DateTime @default(now())
  initialQty    Float
  remainingQty  Float
  unitCost      Float
  currency      String   @default("TRY")
  isExhausted   Boolean  @default(false)
  createdAt     DateTime @default(now())

  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([itemId, warehouseId, isExhausted, layerDate])
}

model StockMovement {
  id                   String   @id @default(uuid())
  itemId               String
  warehouseId          String
  movementType         String   // RECEIPT, ISSUE, TRANSFER_OUT, TRANSFER_IN, PRODUCTION_CONSUME, PRODUCTION_OUTPUT, COUNT_ADJUSTMENT, CONSIGNMENT_CONSUME, RMA_RETURN
  quantity             Float
  unit                 String   @default("Adet")
  valuationMethodUsed  String   @default("FIFO")
  unitCost             Float    @default(0)
  totalCost            Float    @default(0)
  standardCostVariance Float    @default(0)
  lotNumber            String?
  serialNumber         String?
  fromBinCode          String?
  toBinCode            String?
  lpnCode              String?
  referenceDocNo       String?
  performedBy          String?
  notes                String?
  createdAt            DateTime @default(now())

  item                 InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse            Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([warehouseId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// FAZ 2: İLERİ SEVİYE DEPO YÖNETİM SİSTEMİ (WMS) VE MOBİL/SAHA OPERASYONLARI
// ═══════════════════════════════════════════════════════════════════════════════

model WarehouseZone {
  id              String   @id @default(uuid())
  warehouseId     String
  code            String
  name            String
  zoneType        String   @default("STORAGE") // RECEIVING, QC, FAST_PICK, BULK_STORAGE, COLD_STORAGE, QUARANTINE, PACKING, SHIPPING
  temperatureMin  Float?
  temperatureMax  Float?
  humidityMax     Float?
  createdAt       DateTime @default(now())

  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins            StorageBin[]

  @@index([warehouseId])
}

model StorageBin {
  id               String   @id @default(uuid())
  warehouseId      String
  zoneId           String
