  customerId        String
  name              String
  url               String
  type              String   @default("Sozlesme") // Contract, Offer, Invoice etc.
  contentCalendarId String?
  createdAt         DateTime @default(now())

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
