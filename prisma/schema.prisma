}

model CustomerTask {
  id          String   @id @default(uuid())
  customerId  String
  title       String
  description String?
  assignedTo  String?  // user id (optional)
  dueDate     DateTime?
  attachments String?  @default("[]") // JSON array of uploaded file URLs
  priority    String   @default("normal") // low, normal, high
  status      String   @default("Fikir / Brief Aşamasında")
