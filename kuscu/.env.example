# Kuşçu — Yerel FinGPT Yapılandırması
# Bu dosyayı .env olarak kopyalayın

# ─── Model Seçimi ─────────────────────────────────────────────────────────────
# Baz model: Llama-2 tabanlı FinGPT için ayarlanmış
# Eğer Llama-2'ye erişiminiz YOKSA aşağıdaki Falcon/Bloom alternatiflerini deneyin:
#
#   FINGPT_BASE_MODEL=tiiuae/falcon-7b
#   FINGPT_LORA_MODEL=FinGPT/fingpt-mt_falcon-7b_lora
#
#   FINGPT_BASE_MODEL=bigscience/bloom-7b1
#   FINGPT_LORA_MODEL=FinGPT/fingpt-mt_bloom-7b1_lora
#
#   FINGPT_BASE_MODEL=mosaicml/mpt-7b
#   FINGPT_LORA_MODEL=FinGPT/fingpt-mt_mpt-7b_lora

FINGPT_BASE_MODEL=tiiuae/falcon-7b
FINGPT_LORA_MODEL=FinGPT/fingpt-mt_falcon-7b_lora

# ─── Quantization ─────────────────────────────────────────────────────────────
# "4bit"  → En az VRAM (~5-6 GB VRAM)  ← ÖNERİLEN
# "8bit"  → Daha doğru, ~8-10 GB VRAM
# "none"  → Full precision (CPU için)
QUANT_MODE=4bit

# ─── Üretim Parametreleri ─────────────────────────────────────────────────────
MAX_NEW_TOKENS=512
TEMPERATURE=0.7

# ─── Sunucu ───────────────────────────────────────────────────────────────────
KUSCU_HOST=0.0.0.0
KUSCU_PORT=8765

# ─── HuggingFace Token ────────────────────────────────────────────────────────
# Llama-2 içinHuggingFace'te model sahibinden erişim talep edilmeli.
# Falcon/Bloom/MPT için token GEREKMEZ.
# https://huggingface.co/settings/tokens
HF_TOKEN=
